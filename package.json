{
  "name": "avalon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource/alfa-slab-one": "^5.1.0",
    "@fontsource/anton": "^5.1.0",
    "@fontsource/dela-gothic-one": "^5.1.0",
    "@fontsource/pirata-one": "^5.1.0",
    "@fontsource/rubik-mono-one": "^5.1.0",
    "@fontsource/special-elite": "^5.1.0",
    "express": "^4.21.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
